{
  "name": "ponraaj-me",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "dev": "astro build && wrangler dev --config dist/server/wrangler.dev.json --port 3000 --persist-to .wrangler/state",
    "build": "astro build",
    "preview": "astro preview",
    "astro:dev": "astro dev --port 3000",
    "check": "wrangler types && astro check && prettier --check .",
    "format": "prettier --write .",
    "deploy": "pnpm build && wrangler d1 migrations apply portfolio-search --remote && wrangler d1 execute portfolio-search --remote --file=dist/seed.sql && wrangler deploy --config dist/server/wrangler.json",
    "db:migrate:local": "wrangler d1 migrations apply portfolio-search --local",
    "db:migrate:remote": "wrangler d1 migrations apply portfolio-search --remote",
    "db:seed:local": "wrangler d1 execute portfolio-search --local --file=dist/seed.sql",
    "db:seed:remote": "wrangler d1 execute portfolio-search --remote --file=dist/seed.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.3",
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@resvg/resvg-wasm": "^2.6.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.9",
    "astro-embed": "^0.13.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide": "^1.24.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "satori": "^0.29.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.3.2",
    "yoga-layout": "^3.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^22.10.2",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.3",
    "typescript": "^5.7.2",
    "wrangler": "^4.110.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
