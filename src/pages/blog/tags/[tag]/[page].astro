---
export const prerender = true;

import { siteUrl } from '@lib/site';
import BaseLayout from '@layouts/BaseLayout.astro';
import PostCard from '@components/PostCard.astro';
import Pagination from '@components/Pagination.astro';
import {
  filterPostsByTag,
  getAllTags,
  getPublishedPosts,
  paginatePosts,
} from '@lib/posts';

export async function getStaticPaths() {
  const allPosts = await getPublishedPosts();
  const tags = getAllTags(allPosts);
  const paths: Array<{ params: { tag: string; page: string }; props: { tag: string; page: number } }> = [];

  for (const tag of tags) {
    const tagged = filterPostsByTag(allPosts, tag);
    const totalPages = Math.max(1, Math.ceil(tagged.length / 10));

    for (let page = 2; page <= totalPages; page += 1) {
      paths.push({
        params: { tag: tag.toLowerCase(), page: String(page) },
        props: { tag, page },
      });
    }
  }

  return paths;
}

const { tag, page } = Astro.props;
const allPosts = await getPublishedPosts();
const tagged = filterPostsByTag(allPosts, tag);
const pagination = paginatePosts(tagged, page);
const basePath = `/blog/tags/${tag.toLowerCase()}`;

if (page < 2 || page > pagination.totalPages) {
  return Astro.redirect('/404');
}
---

<BaseLayout
  title={`Posts tagged "${tag}" — Page ${page}`}
  description={`Blog posts tagged with ${tag}`}
  canonical={new URL(`${basePath}/${page}`, siteUrl(Astro.site)).href}
>
  <div class="min-h-screen page-bg">
    <div class="max-w-3xl mx-auto px-6 py-40">
      <header class="mb-24">
        <p class="text-sm uppercase tracking-wider text-subtle mb-4">Tag</p>
        <h1 class="text-5xl md:text-6xl mb-6 text-foreground font-light tracking-tight">
          {tag}
        </h1>
        <p class="text-lg text-subtle leading-relaxed">
          Page {page} of {pagination.totalPages}
        </p>
      </header>

      <div class="space-y-20">
        {pagination.posts.map((post) => <PostCard post={post} />)}
      </div>

      <Pagination
        page={pagination.page}
        totalPages={pagination.totalPages}
        basePath={basePath}
      />
    </div>
  </div>
</BaseLayout>
