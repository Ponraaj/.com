---
export const prerender = true;

import { siteUrl } from '@lib/site';
import BaseLayout from '@layouts/BaseLayout.astro';
import PostCard from '@components/PostCard.astro';
import Pagination from '@components/Pagination.astro';
import { getPublishedPosts, paginatePosts } from '@lib/posts';

const allPosts = await getPublishedPosts();
const { posts, page, totalPages } = paginatePosts(allPosts, 1);
---

<BaseLayout
  title="Blog"
  description="Just some thoughts and scribblings"
  image="/og/blog.png"
  canonical={new URL('/blog', siteUrl(Astro.site)).href}
>
  <div class="min-h-screen page-bg">
    <div class="max-w-3xl mx-auto px-6 py-40">
      <header class="mb-24">
        <h1 class="text-5xl md:text-6xl mb-6 text-foreground font-light tracking-tight" style="view-transition-name: page-heading">
          Blog
        </h1>
        <p class="text-lg text-subtle leading-relaxed">
          Thoughts on technology, development, and life
        </p>
      </header>

      <div class="mb-20">
        <div class="relative max-w-md mx-auto md:mx-0">
          <svg
            class="absolute left-3 top-1/2 -translate-y-1/2 text-subtle w-4 h-4"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.3-4.3" />
          </svg>
          <input
            id="blog-search"
            type="search"
            placeholder="Search posts..."
            class="w-full pl-10 pr-4 py-2.5 bg-surface border border-border/60 rounded-md text-foreground placeholder-muted-foreground/60 focus:outline-none transition-colors"
            autocomplete="off"
          />
        </div>
        <p id="search-results" class="mt-4 text-sm text-subtle hidden" aria-live="polite" />
      </div>

      <div id="post-list" class="space-y-20">
        {
          posts.map((post) => (
            <div class="post-item" data-title={post.data.title.toLowerCase()} data-excerpt={post.data.excerpt.toLowerCase()} data-tags={post.data.tags.join(' ').toLowerCase()}>
              <PostCard post={post} />
            </div>
          ))
        }
      </div>

      <div id="no-results" class="py-20 text-center hidden">
        <p class="text-subtle text-lg">No posts found matching your search</p>
      </div>

      <Pagination page={page} totalPages={totalPages} basePath="/blog" />
    </div>
  </div>
</BaseLayout>

<script>
  function initBlogSearch() {
    const input = document.getElementById('blog-search') as HTMLInputElement | null;
    const items = document.querySelectorAll('.post-item');
    const noResults = document.getElementById('no-results');
    const resultsLabel = document.getElementById('search-results');

    if (!input) return;

    input.addEventListener('input', () => {
      const query = input.value.trim().toLowerCase();
      let visible = 0;

      items.forEach((item) => {
        const title = item.getAttribute('data-title') ?? '';
        const excerpt = item.getAttribute('data-excerpt') ?? '';
        const tags = item.getAttribute('data-tags') ?? '';
        const match =
          !query ||
          title.includes(query) ||
          excerpt.includes(query) ||
          tags.includes(query);

        item.classList.toggle('hidden', !match);
        if (match) visible += 1;
      });

      if (query) {
        resultsLabel?.classList.remove('hidden');
        if (resultsLabel) {
          resultsLabel.textContent = `${visible} post${visible !== 1 ? 's' : ''} found`;
        }
      } else {
        resultsLabel?.classList.add('hidden');
      }

      noResults?.classList.toggle('hidden', visible > 0 || !query);
    });
  }

  initBlogSearch();
  document.addEventListener('astro:page-load', initBlogSearch);
</script>
