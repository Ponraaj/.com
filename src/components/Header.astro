---
const pathname = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(`${href}/`);
}

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
];
---

<header class="py-6 px-4 border-b border-subtle header-bg" transition:persist>
  <div class="max-w-4xl mx-auto flex items-center justify-between">
    <a
      href="/"
      class="text-xl hover:opacity-70 transition-opacity text-foreground"
      style="view-transition-name: site-logo"
    >
      Pon Raaj V
    </a>

    <div class="hidden md:flex items-center space-x-6">
      <nav class="flex items-center space-x-8">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                'relative group transition-colors duration-300 text-base',
                isActive(item.href)
                  ? 'text-primary'
                  : 'text-subtle hover:text-primary',
              ]}
            >
              <span class="relative">
                {item.label}
                <span class="absolute left-0 bottom-0 w-0 h-px bg-primary transition-all duration-300 ease-out group-hover:w-full" />
              </span>
            </a>
          ))
        }
      </nav>

      <button
        id="theme-toggle-desktop"
        type="button"
        class="text-subtle hover:text-foreground transition-colors"
        aria-label="Toggle theme"
      >
        <svg
          class="icon-moon w-5 h-5"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
        <svg
          class="icon-sun w-5 h-5 hidden"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2" />
          <path d="M12 20v2" />
          <path d="m4.93 4.93 1.41 1.41" />
          <path d="m17.66 17.66 1.41 1.41" />
          <path d="M2 12h2" />
          <path d="M20 12h2" />
          <path d="m6.34 17.66-1.41 1.41" />
          <path d="m19.07 4.93-1.41 1.41" />
        </svg>
      </button>
    </div>

    <div class="md:hidden flex items-center space-x-4">
      <button
        id="theme-toggle-mobile"
        type="button"
        class="text-subtle hover:text-foreground transition-colors"
        aria-label="Toggle theme"
      >
        <svg
          class="icon-moon w-5 h-5"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
        <svg
          class="icon-sun w-5 h-5 hidden"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2" />
          <path d="M12 20v2" />
          <path d="m4.93 4.93 1.41 1.41" />
          <path d="m17.66 17.66 1.41 1.41" />
          <path d="M2 12h2" />
          <path d="M20 12h2" />
          <path d="m6.34 17.66-1.41 1.41" />
          <path d="m19.07 4.93-1.41 1.41" />
        </svg>
      </button>
      <button
        id="mobile-menu-open"
        type="button"
        class="mobile-menu-trigger text-subtle hover:text-foreground transition-colors"
        aria-label="Open menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg
          class="w-5 h-5"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="4" x2="20" y1="12" y2="12" />
          <line x1="4" x2="20" y1="6" y2="6" />
          <line x1="4" x2="20" y1="18" y2="18" />
        </svg>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu-shell" class="mobile-menu-shell md:hidden" aria-hidden="true">
  <button id="mobile-menu-backdrop" class="mobile-menu-backdrop" type="button" aria-label="Close menu"></button>

  <aside id="mobile-menu" class="mobile-menu-panel" aria-label="Mobile navigation">
    <div class="mobile-menu-header">
      <button
        id="mobile-menu-close"
        type="button"
        class="mobile-menu-close text-subtle hover:text-foreground transition-colors"
        aria-label="Close menu"
      >
        <svg
          class="w-5 h-5"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18" />
          <path d="m6 6 12 12" />
        </svg>
      </button>
    </div>

    <nav class="mobile-menu-nav">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            data-mobile-nav
            class:list={['mobile-menu-link', isActive(item.href) && 'is-active']}
          >
            <span>{item.label}</span>
            <svg
              class="mobile-menu-arrow"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14" />
              <path d="m13 6 6 6-6 6" />
            </svg>
          </a>
        ))
      }
    </nav>

  </aside>
</div>

<script>
  let headerEvents: AbortController | undefined;

  function getTheme() {
    return document.documentElement.classList.contains('dark') ? 'dark' : 'light';
  }

  function setTheme(theme: 'dark' | 'light') {
    document.documentElement.dataset.theme = theme;
    document.documentElement.classList.toggle('dark', theme === 'dark');
    document.documentElement.style.colorScheme = theme;
    try {
      localStorage.setItem('theme', theme);
    } catch {}
    updateThemeIcons();
  }

  function updateThemeIcons() {
    const isDark = getTheme() === 'dark';
    document.querySelectorAll('#theme-toggle-desktop, #theme-toggle-mobile').forEach((btn) => {
      btn.querySelectorAll('.icon-moon').forEach((el) => {
        el.classList.toggle('hidden', isDark);
      });
      btn.querySelectorAll('.icon-sun').forEach((el) => {
        el.classList.toggle('hidden', !isDark);
      });
    });
  }

  function toggleTheme() {
    setTheme(getTheme() === 'dark' ? 'light' : 'dark');
  }

  function updateActiveNav() {
    const path = location.pathname;
    document.querySelectorAll('header nav a').forEach((link) => {
      const href = link.getAttribute('href') ?? '';
      const isActive = href === '/'
        ? path === '/'
        : path === href || path.startsWith(href + '/');
      link.classList.toggle('text-primary', isActive);
      link.classList.toggle('text-subtle', !isActive);
    });
  }

  function initHeader() {
    headerEvents?.abort();
    headerEvents = new AbortController();
    const { signal } = headerEvents;

    document.body.classList.remove('menu-open');

    updateActiveNav();
    updateThemeIcons();

    document
      .getElementById('theme-toggle-desktop')
      ?.addEventListener('click', toggleTheme, { signal });
    document
      .getElementById('theme-toggle-mobile')
      ?.addEventListener('click', toggleTheme, { signal });

    const shell = document.getElementById('mobile-menu-shell');
    const menu = document.getElementById('mobile-menu');
    const openBtn = document.getElementById('mobile-menu-open');
    const closeBtn = document.getElementById('mobile-menu-close');
    const backdrop = document.getElementById('mobile-menu-backdrop');

    shell?.classList.remove('is-open');
    shell?.setAttribute('aria-hidden', 'true');
    openBtn?.setAttribute('aria-expanded', 'false');

    const setMenuOpen = (isOpen: boolean, returnFocus = true) => {
      shell?.classList.toggle('is-open', isOpen);
      shell?.setAttribute('aria-hidden', String(!isOpen));
      openBtn?.setAttribute('aria-expanded', String(isOpen));
      document.body.classList.toggle('menu-open', isOpen);

      if (isOpen) {
        requestAnimationFrame(() => closeBtn?.focus());
      } else if (returnFocus) {
        openBtn?.focus();
      }
    };

    openBtn?.addEventListener(
      'click',
      () => setMenuOpen(true),
      { signal },
    );

    closeBtn?.addEventListener(
      'click',
      () => setMenuOpen(false),
      { signal },
    );

    backdrop?.addEventListener('click', () => setMenuOpen(false), { signal });

    document.querySelectorAll('[data-mobile-nav]').forEach((link) => {
      link.addEventListener(
        'click',
        () => setMenuOpen(false, false),
        { signal },
      );
    });

    document.addEventListener(
      'keydown',
      (event) => {
        if (!shell?.classList.contains('is-open')) return;

        if (event.key === 'Escape') {
          event.preventDefault();
          setMenuOpen(false);
          return;
        }

        if (event.key !== 'Tab' || !menu) return;
        const focusable = Array.from(
          menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
        );
        if (!focusable.length) return;

        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      },
      { signal },
    );

    window.addEventListener(
      'resize',
      () => {
        if (window.matchMedia('(min-width: 768px)').matches) setMenuOpen(false, false);
      },
      { signal },
    );
  }

  initHeader();
  document.addEventListener('astro:after-swap', initHeader);
</script>
